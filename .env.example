# Which backend to use: "valtown" (default) or "supabase".
# Build-time flag — restart `npm run dev` after changing it.
NEXT_PUBLIC_BACKEND=valtown

# --- Val Town backend (used when NEXT_PUBLIC_BACKEND=valtown) ---
# Base URL of the CLRA API (the Val Town backend). No trailing slash.
NEXT_PUBLIC_API_URL=https://minhthanh3145--d0b84c16583c11f1ba6dee650bb23af1.web.val.run

# --- Supabase backend (used when NEXT_PUBLIC_BACKEND=supabase) ---
# Not implemented yet — these are placeholders for when the Supabase
# providers under src/api/providers/supabase/ are filled in.
# NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
